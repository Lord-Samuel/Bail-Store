{
  "name": "bail-store",
  "version": "1.1.0",
  "description": "Store management for Baileys WhatsApp library",
  "keywords": [
    "whatsapp",
    "automation"
  ],
  "homepage": "https://github.com/Lord-Samuel/Bail-Store",
  "repository": {
    "url": "git@github.com:Lord-Samuel/Bail-Store.git"
  },
  "license": "MIT",
  "author": "Lord-Samuel",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src/*"
  ],
  "scripts": {
    "build:all": "tsc && typedoc",
    "build:docs": "typedoc",
    "build:tsc": "tsc",
    "changelog:last": "conventional-changelog -p angular -r 2",
    "changelog:preview": "conventional-changelog -p angular -u",
    "changelog:update": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "lint": "eslint src --ext .js,.ts",
    "lint:fix": "yarn lint --fix",
    "prepack": "tsc",
    "prepare": "tsc",
    "release": "release-it",
    "test": "jest"
  },
  "dependencies": {
    "@adiwajshing/keyed-db": "0.2.4",
    "cache-manager": "7.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@whiskeysockets/eslint-config": "github:whiskeysockets/eslint-config",
    "baileys": "npm:bail-lite",
    "conventional-changelog-cli": "^5.0.0",
    "release-it": "^19.0.6",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "4.9.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "baileys": "npm:bail-lite"
  },
  "peerDependenciesMeta": {
    "baileys": {
      "optional": false
    }
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.0.0"
  }
}
